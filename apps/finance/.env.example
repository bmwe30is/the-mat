# --- Database: NEW dedicated Supabase project (not the-mat's DB) ---
# Use the direct connection (5432) or the session-mode pooler for this CLI.
# Newer Supabase direct hosts are IPv6-only; if the direct host won't connect,
# use the "Session pooler" URI from Connect → Connection string (also port 5432).
FINANCE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
FINANCE_DB_SSL=true
# Optional: path to Supabase's CA cert (Settings → Database → SSL). When set, the
# server certificate is verified; when unset, TLS is still used but unverified.
FINANCE_DB_SSL_CA=

# --- Acuity (Basic auth: user id + API key) ---
ACUITY_USER_ID=
ACUITY_API_KEY=
ACUITY_REQUESTS_PER_SEC=1

# --- Square ---
SQUARE_ACCESS_TOKEN=
# Keep comments on their own line: `KEY=   # note` makes dotenv read KEY as empty.
# SQUARE_ENV: production | sandbox
SQUARE_ENV=production
# Pin both even though there's one location today (values found by the probe).
SQUARE_LOCATION_ID=EAJEBA375QYQN
SQUARE_VERSION=2025-01-23

# --- Behaviour ---
REPORTING_TZ=America/Los_Angeles
SEED_START=2020-03-01            # inclusive, LA local date
SEED_END=2020-12-31              # inclusive, LA local date
MATCH_WINDOW_MINUTES=15
MEMBERSHIP_TYPE_PATTERNS=Membership   # comma-separated, case-insensitive, used by classify
